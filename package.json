{
  "name": "mathboard",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:agent": "vite --mode agent --host 127.0.0.1 --port 5173 --strictPort",
    "build:app": "vite build",
    "build:seo": "node tools/build-seo.mjs",
    "build": "npm run build:app && npm run build:seo",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.mjs,.vue src/ dev-agent/ e2e-agent/ tools/vite/ playwright.agent.config.js vite.config.js",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "npm run build:e2e && npm run assert:e2e-hook && playwright test",
    "test:agent-bridge": "playwright test --config playwright.agent.config.js",
    "test:e2e:ui": "npm run build:e2e && npm run assert:e2e-hook && playwright test --ui",
    "assert:no-e2e-hook": "node tools/assert-no-e2e-hook.mjs",
    "assert:e2e-hook": "node tools/assert-e2e-hook.mjs",
    "generate:icons": "node tools/generate-icons.mjs",
    "generate:favicons": "node tools/generate-icons.mjs --favicons-only",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:info": "tauri info"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/vue-fontawesome": "^3.0.5",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "fabric": "^7.4.0",
    "katex": "^0.18.2",
    "vue": "^3.5.44",
    "@fontsource/satisfy": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^10.11.1",
    "puppeteer": "^25.12.0",
    "vite": "^6.4.5",
    "wrangler": "^4.154.0",
    "@tauri-apps/cli": "^2.12.1",
    "fake-indexeddb": "^6.2.6"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "es2020": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module"
    },
    "rules": {}
  }
}
