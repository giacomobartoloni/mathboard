{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mcp-permissions",
  "description": "Allow local MCP grant controls only from the main MathBoard WebView",
  "webviews": ["main"],
  "permissions": [
    "allow-mcp-permission-status",
    "allow-mcp-set-enabled",
    "allow-mcp-grant-read",
    "allow-mcp-grant-screenshot",
    "allow-mcp-revoke-all"
  ]
}
