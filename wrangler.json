{
  "name": "mathboard",
  "compatibility_date": "2026-02-13",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "BOARD_SHARES",
      "bucket_name": "mathboard-board-shares"
    }
  ],
  "ratelimits": [
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "24016",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "previews": {
    "r2_buckets": [
      {
        "binding": "BOARD_SHARES",
        "bucket_name": "mathboard-board-shares-preview"
      }
    ],
    "ratelimits": [
      {
        "name": "SHARE_RATE_LIMITER",
        "namespace_id": "24017",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "redact_query_string": true
  }
}
