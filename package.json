{
  "name": "mathboard",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:app": "vite build",
    "build:seo": "node tools/build-seo.mjs",
    "build": "npm run build:app && npm run build:seo",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue src/",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "npm run build:e2e && npm run assert:e2e-hook && playwright test",
    "test:e2e:ui": "npm run build:e2e && npm run assert:e2e-hook && playwright test --ui",
    "assert:no-e2e-hook": "node tools/assert-no-e2e-hook.mjs",
    "assert:e2e-hook": "node tools/assert-e2e-hook.mjs",
    "generate:icons": "node tools/generate-icons.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/vue-fontawesome": "^3.0.5",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "fabric": "^7.4.0",
    "katex": "^0.16.28",
    "vue": "^3.4.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "puppeteer": "^25.12.0",
    "vite": "^6.3.5"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "es2020": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module"
    },
    "rules": {}
  }
}
