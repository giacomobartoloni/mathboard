{
  "name": "mathboard",
  "compatibility_date": "2026-02-13",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "BOARD_SHARES",
      "bucket_name": "mathboard-board-shares"
    }
  ],
  "ratelimits": [
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "24016",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "previews": {}
}
